@Metadata.layer: #CUSTOMER
annotate entity zjkr_c_cust_email
    with 
{

    @UI.facet: [  
        { id:  'Email',
          purpose:  #STANDARD,
          type:  #IDENTIFICATION_REFERENCE,
          label:         'Email',
          position:      10 
         }
    ]

    @UI.identification: [{          
        position: 10
    }]
    @Search.defaultSearchElement: true
    @UI.lineItem: [{  
        position: 10,
        qualifier: 'Email'
    }]        
    EmailId;    
    
    @UI.identification: [{          
        position: 40
    }]
    @UI.lineItem: [{  
        position: 40,
        qualifier: 'Email'
    }]    
    Email;
    @UI.identification: [{          
        position: 50
    }]
    @UI.lineItem: [{  
        position: 50,
        qualifier: 'Email'
    }]
    DefaultEmail;
    
    @UI.hidden: true
    LastChangedAt;
    
}